// Copy this file to Local.xcconfig and replace the placeholders.
// Keep $() between URL slashes: xcconfig otherwise treats // as a comment.
SUPABASE_URL = https:/$()/your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY = your-publishable-key

// Optional; Shared.xcconfig already supplies this default.
// SUPABASE_AUTH_REDIRECT_URL = cheeseapp:/$()/auth/callback

// Optional local Cheese AI Worker endpoint.
// CHEESE_AI_TRIGGER_URL = http:/$()/127.0.0.1:8787/v1/comment-events
