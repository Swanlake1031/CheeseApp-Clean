{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cheeseapp-ai-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "run_worker_first": [
      "/health",
      "/v1/comment-events",
      "/v1/secondhand/generate-description",
      "/v1/media/upload"
    ]
  },
  "vars": {
    "CHEESE_AI_USER_ID": "e5983890-95ad-4b6c-814b-863bfde4e4fc",
    "SUPABASE_URL": "https://zeuivahkowbxmfzsnagt.supabase.co",
    "CHEESE_RECOMMENDATION_JOBS_ENABLED": "true",
    "CHEESE_RECOMMENDATION_SHADOW_ENABLED": "true",
    "CHEESE_MEDIA_MODERATION_ENABLED": "false"
  },
  "ratelimits": [
    {
      "name": "SECONDHAND_AI_RATE_LIMITER",
      "namespace_id": "2026082701",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "MEDIA_MODERATION_RATE_LIMITER",
      "namespace_id": "2026091101",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "ai.cheeseapp.org",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
